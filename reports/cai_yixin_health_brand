<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>蔡一信健康陪跑品牌企劃</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --forest: #1E4D3A;
    --moss: #2E6B50;
    --sage: #5A8C72;
    --mist: #A8C5B5;
    --cream: #F7F3EE;
    --warm: #EDE8E0;
    --gold: #C8A96E;
    --amber: #E8C87A;
    --bark: #6B4F3A;
    --ink: #2C2A27;
    --soft: #7A7068;
    --white: #FEFCF9;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Noto Sans TC', sans-serif;
    background: var(--cream);
    color: var(--ink);
    line-height: 1.8;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 999;
    background: rgba(30,77,58,0.97);
    backdrop-filter: blur(12px);
    padding: 0 2rem;
    display: flex; align-items: center; justify-content: space-between;
    height: 58px;
    box-shadow: 0 2px 20px rgba(0,0,0,0.15);
  }
  nav .logo {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900; font-size: 1rem;
    color: var(--amber); letter-spacing: 0.05em;
    white-space: nowrap;
  }
  nav ul {
    display: flex; gap: 0; list-style: none; overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul::-webkit-scrollbar { display: none; }
  nav ul li a {
    display: block; padding: 0 0.75rem; height: 58px;
    line-height: 58px; font-size: 0.78rem; color: var(--mist);
    text-decoration: none; white-space: nowrap;
    transition: color 0.2s, background 0.2s;
    letter-spacing: 0.03em;
  }
  nav ul li a:hover { color: var(--amber); background: rgba(255,255,255,0.05); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    background: linear-gradient(160deg, var(--forest) 0%, #0E2D1F 60%, #162B1E 100%);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 6rem 2rem 4rem;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(90,140,114,0.15) 0%, transparent 70%);
  }
  .hero-tag {
    display: inline-block;
    background: rgba(200,169,110,0.2);
    border: 1px solid rgba(200,169,110,0.4);
    color: var(--amber);
    padding: 0.4rem 1.2rem; border-radius: 99px;
    font-size: 0.8rem; letter-spacing: 0.15em;
    margin-bottom: 2rem;
    animation: fadeUp 0.8s ease both;
  }
  .hero h1 {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 900; color: var(--white);
    line-height: 1.25; margin-bottom: 1rem;
    animation: fadeUp 0.8s 0.15s ease both;
    position: relative; z-index: 1;
  }
  .hero h1 span { color: var(--amber); }
  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--mist); max-width: 560px;
    animation: fadeUp 0.8s 0.3s ease both;
    position: relative; z-index: 1;
    margin-bottom: 2.5rem;
  }
  .hero-btns {
    display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
    animation: fadeUp 0.8s 0.45s ease both;
    position: relative; z-index: 1;
  }
  .btn-primary {
    background: var(--gold);
    color: var(--forest);
    padding: 0.75rem 2rem; border-radius: 8px;
    font-weight: 700; font-size: 0.9rem;
    text-decoration: none; letter-spacing: 0.05em;
    transition: all 0.25s;
  }
  .btn-primary:hover { background: var(--amber); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(200,169,110,0.35); }
  .btn-outline {
    border: 1.5px solid rgba(168,197,181,0.5);
    color: var(--mist); padding: 0.75rem 2rem; border-radius: 8px;
    font-size: 0.9rem; text-decoration: none; letter-spacing: 0.05em;
    transition: all 0.25s;
  }
  .btn-outline:hover { border-color: var(--mist); color: var(--white); background: rgba(255,255,255,0.05); }

  .hero-funnel {
    position: relative; z-index: 1;
    margin-top: 4rem;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0; align-items: center;
  }
  .funnel-step {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(168,197,181,0.2);
    border-radius: 8px; padding: 0.5rem 1rem;
    font-size: 0.75rem; color: var(--mist);
    white-space: nowrap;
    animation: fadeUp 0.6s ease both;
  }
  .funnel-arrow {
    color: var(--sage); font-size: 0.9rem; padding: 0 0.3rem;
  }

  /* ── SECTION BASE ── */
  section { padding: 5rem 2rem; }
  .container { max-width: 960px; margin: 0 auto; }
  .section-label {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--sage); font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .section-label::before {
    content: ''; width: 24px; height: 2px; background: var(--sage);
  }
  h2 {
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 900; color: var(--forest);
    margin-bottom: 1rem; line-height: 1.3;
  }
  .lead {
    font-size: 1.05rem; color: var(--soft);
    max-width: 600px; margin-bottom: 3rem;
  }

  /* ── POSITIONING ── */
  .positioning { background: var(--white); }
  .pos-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem; margin-top: 2rem;
  }
  .pos-card {
    background: var(--cream);
    border-left: 3px solid var(--sage);
    padding: 1.5rem; border-radius: 0 8px 8px 0;
  }
  .pos-card h3 {
    font-size: 0.85rem; font-weight: 700; color: var(--moss);
    letter-spacing: 0.1em; margin-bottom: 0.75rem;
  }
  .pos-card p, .pos-card ul { font-size: 0.9rem; color: var(--soft); }
  .pos-card ul { padding-left: 1.1rem; }
  .pos-card ul li { margin-bottom: 0.35rem; }

  .diff-table {
    width: 100%; border-collapse: collapse; margin-top: 2rem;
    font-size: 0.9rem;
  }
  .diff-table th {
    background: var(--forest); color: var(--mist);
    padding: 0.75rem 1.25rem; text-align: left;
    font-size: 0.8rem; letter-spacing: 0.08em;
  }
  .diff-table td {
    padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--warm);
  }
  .diff-table tr:nth-child(even) td { background: var(--cream); }
  .diff-table td:last-child { color: var(--moss); font-weight: 500; }

  /* ── STORY ── */
  .story { background: var(--forest); color: var(--white); }
  .story h2 { color: var(--amber); }
  .story .lead { color: var(--mist); }
  .story-quote {
    background: rgba(255,255,255,0.06);
    border-left: 4px solid var(--gold);
    padding: 2rem 2.5rem; border-radius: 0 12px 12px 0;
    font-size: 1rem; color: var(--mist);
    line-height: 2.2; font-style: italic;
    position: relative;
    font-family: 'Noto Serif TC', serif;
  }
  .story-quote::before {
    content: '❝';
    position: absolute; top: -0.5rem; left: 1.5rem;
    font-size: 3rem; color: var(--gold); opacity: 0.4;
    font-style: normal;
  }

  /* ── SLOGANS ── */
  .slogans { background: var(--warm); }
  .slogan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem; margin-top: 2rem;
  }
  .slogan-item {
    background: var(--white); border-radius: 10px;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(0,0,0,0.06);
    display: flex; align-items: flex-start; gap: 0.75rem;
    transition: all 0.2s;
    cursor: default;
  }
  .slogan-item:hover {
    border-color: var(--sage);
    box-shadow: 0 4px 16px rgba(46,107,80,0.1);
    transform: translateY(-2px);
  }
  .slogan-num {
    font-size: 0.7rem; font-weight: 700; color: var(--mist);
    min-width: 22px; margin-top: 0.15rem;
  }
  .slogan-text { font-size: 0.92rem; color: var(--ink); font-weight: 500; }
  .slogan-cat {
    font-size: 0.7rem; color: var(--sage);
    background: rgba(90,140,114,0.12);
    padding: 0.15rem 0.5rem; border-radius: 4px;
    margin-bottom: 0.4rem; display: inline-block;
  }

  /* ── NAMECARD ── */
  .namecard { background: var(--white); }
  .cta-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem; margin-top: 2rem;
  }
  .cta-card {
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--warm);
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    transition: all 0.25s;
  }
  .cta-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.1); }
  .cta-header {
    padding: 1.5rem; color: var(--white);
    font-family: 'Noto Serif TC', serif;
  }
  .cta-header.c1 { background: linear-gradient(135deg, var(--forest), var(--moss)); }
  .cta-header.c2 { background: linear-gradient(135deg, #3B6E4A, #5A8C72); }
  .cta-header.c3 { background: linear-gradient(135deg, var(--bark), #8B6A4A); }
  .cta-header .cta-tag {
    font-size: 0.7rem; letter-spacing: 0.2em;
    opacity: 0.8; margin-bottom: 0.5rem;
  }
  .cta-header h3 { font-size: 1.2rem; font-weight: 900; }
  .cta-header .cta-btn {
    display: inline-block; margin-top: 0.75rem;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.35);
    padding: 0.4rem 1rem; border-radius: 6px;
    font-size: 0.82rem; color: var(--white);
    cursor: pointer;
  }
  .cta-body { padding: 1.5rem; }
  .cta-body h4 {
    font-size: 0.85rem; font-weight: 700; color: var(--moss);
    margin-bottom: 0.75rem; letter-spacing: 0.05em;
  }
  .cta-block {
    background: var(--cream); border-radius: 8px;
    padding: 1rem; margin-bottom: 0.75rem;
    font-size: 0.85rem; color: var(--soft);
    border-left: 3px solid var(--mist);
  }
  .cta-block strong { color: var(--ink); display: block; margin-bottom: 0.25rem; }
  .cta-action {
    display: block; text-align: center;
    background: var(--forest); color: var(--white);
    padding: 0.65rem; border-radius: 8px;
    font-size: 0.85rem; font-weight: 600;
    margin-top: 1rem; text-decoration: none;
    letter-spacing: 0.05em;
    transition: background 0.2s;
  }
  .cta-action:hover { background: var(--moss); }

  /* ── PWA GAME ── */
  .pwa-game { background: linear-gradient(160deg, #0E2D1F 0%, var(--forest) 100%); color: var(--white); }
  .pwa-game h2 { color: var(--amber); }
  .pwa-game .lead { color: var(--mist); }
  .levels-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem; margin-top: 2rem;
  }
  .level-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(168,197,181,0.2);
    border-radius: 12px; padding: 1.5rem;
    transition: all 0.25s;
    position: relative; overflow: hidden;
  }
  .level-card::before {
    content: '';
    position: absolute; top: -40px; right: -40px;
    width: 100px; height: 100px;
    background: radial-gradient(circle, rgba(200,169,110,0.15) 0%, transparent 70%);
    border-radius: 50%;
  }
  .level-card:hover { border-color: var(--gold); transform: translateY(-3px); }
  .level-num {
    font-size: 0.7rem; font-weight: 700; color: var(--amber);
    letter-spacing: 0.2em; margin-bottom: 0.5rem;
  }
  .level-card h3 { font-size: 1.05rem; color: var(--white); margin-bottom: 0.75rem; }
  .level-card ul { padding-left: 1.1rem; font-size: 0.85rem; color: var(--mist); }
  .level-card li { margin-bottom: 0.3rem; }

  .result-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem; margin-top: 2rem;
  }
  .result-card {
    border-radius: 10px; padding: 1.25rem; text-align: center;
  }
  .result-card.r1 { background: rgba(90,140,114,0.2); border: 1px solid var(--sage); }
  .result-card.r2 { background: rgba(200,169,110,0.15); border: 1px solid var(--gold); }
  .result-card.r3 { background: rgba(232,200,122,0.15); border: 1px solid var(--amber); }
  .result-card.r4 { background: rgba(200,100,100,0.15); border: 1px solid #c87878; }
  .result-score { font-size: 1.5rem; font-weight: 900; margin-bottom: 0.25rem; }
  .result-card.r1 .result-score { color: var(--sage); }
  .result-card.r2 .result-score { color: var(--gold); }
  .result-card.r3 .result-score { color: var(--amber); }
  .result-card.r4 .result-score { color: #e87878; }
  .result-label { font-size: 0.95rem; color: var(--white); font-weight: 700; margin-bottom: 0.4rem; }
  .result-sub { font-size: 0.8rem; color: var(--mist); }

  /* ── LINE COMMUNITY ── */
  .community { background: var(--warm); }
  .week-table {
    width: 100%; border-collapse: collapse; margin-top: 1.5rem;
    font-size: 0.88rem;
  }
  .week-table th {
    background: var(--moss); color: var(--white);
    padding: 0.65rem 1rem; text-align: left;
    font-size: 0.78rem; letter-spacing: 0.08em;
  }
  .week-table td { padding: 0.75rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.06); }
  .week-table tr:nth-child(even) td { background: rgba(255,255,255,0.5); }
  .week-table td:first-child { font-weight: 600; color: var(--moss); white-space: nowrap; }

  .referral-steps {
    display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem;
  }
  .ref-step {
    background: var(--white); border-radius: 8px;
    padding: 1rem 1.25rem; display: flex;
    align-items: center; gap: 1rem;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .ref-icon {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--forest); color: var(--amber);
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 0.9rem; flex-shrink: 0;
  }
  .ref-step p { font-size: 0.88rem; color: var(--ink); }
  .ref-step p strong { color: var(--moss); }

  /* ── PLANS ── */
  .plans { background: var(--white); }
  .plan-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem; margin-top: 2rem;
  }
  .plan-card {
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    transition: all 0.25s;
  }
  .plan-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,0.12); }
  .plan-header {
    padding: 2rem; color: var(--white);
  }
  .plan-header.p30 { background: linear-gradient(135deg, var(--moss), var(--forest)); }
  .plan-header.p90 { background: linear-gradient(135deg, var(--bark), #3A2010); }
  .plan-tag {
    font-size: 0.7rem; letter-spacing: 0.2em; opacity: 0.8; margin-bottom: 0.5rem;
  }
  .plan-header h3 { font-family: 'Noto Serif TC', serif; font-size: 1.4rem; font-weight: 900; }
  .plan-price {
    margin-top: 1rem; font-size: 2rem; font-weight: 900;
    color: var(--amber);
  }
  .plan-price span { font-size: 0.9rem; color: var(--mist); font-weight: 400; }
  .plan-body { padding: 1.75rem; background: var(--cream); }
  .plan-body ul { list-style: none; }
  .plan-body ul li {
    padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.06);
    font-size: 0.88rem; color: var(--soft);
    display: flex; gap: 0.5rem; align-items: flex-start;
  }
  .plan-body ul li::before { content: '✓'; color: var(--sage); font-weight: 700; flex-shrink: 0; }
  .plan-body ul li:last-child { border-bottom: none; }
  .plan-phases { margin-top: 1.5rem; }
  .phase {
    padding: 0.75rem 1rem; border-radius: 8px;
    margin-bottom: 0.75rem; font-size: 0.85rem;
  }
  .phase.ph1 { background: rgba(46,107,80,0.1); border-left: 3px solid var(--moss); }
  .phase.ph2 { background: rgba(200,169,110,0.1); border-left: 3px solid var(--gold); }
  .phase.ph3 { background: rgba(107,79,58,0.1); border-left: 3px solid var(--bark); }
  .phase strong { color: var(--ink); display: block; margin-bottom: 0.2rem; }
  .phase p { color: var(--soft); }

  /* ── FUNNEL ── */
  .funnel-section { background: var(--forest); color: var(--white); }
  .funnel-section h2 { color: var(--amber); }
  .funnel-section .lead { color: var(--mist); }
  .funnel-list {
    display: flex; flex-direction: column; gap: 0; margin-top: 2rem;
    max-width: 640px; margin-left: auto; margin-right: auto;
  }
  .funnel-item {
    display: flex; gap: 1.5rem; align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(168,197,181,0.15);
    border-radius: 12px; margin-bottom: 0.5rem;
    position: relative;
    transition: all 0.2s;
  }
  .funnel-item:hover { background: rgba(255,255,255,0.08); border-color: var(--sage); }
  .funnel-item::after {
    content: '↓';
    position: absolute; bottom: -14px; left: 50%;
    transform: translateX(-50%);
    color: var(--sage); font-size: 1rem; z-index: 2;
  }
  .funnel-item:last-child::after { display: none; }
  .funnel-icon {
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(200,169,110,0.2);
    border: 1px solid rgba(200,169,110,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
  }
  .funnel-content h4 { font-size: 0.95rem; color: var(--white); margin-bottom: 0.3rem; }
  .funnel-content p { font-size: 0.82rem; color: var(--mist); }

  /* ── CONTENT TOPICS ── */
  .topics { background: var(--warm); }
  .tab-bar {
    display: flex; gap: 0.5rem; margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: 0.5rem 1.25rem; border-radius: 99px;
    border: 1.5px solid var(--sage); background: transparent;
    color: var(--moss); font-size: 0.82rem; cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
    transition: all 0.2s;
  }
  .tab-btn.active, .tab-btn:hover {
    background: var(--forest); border-color: var(--forest);
    color: var(--white);
  }
  .topic-panel { display: none; }
  .topic-panel.active { display: block; }
  .topic-cols {
    columns: 2; column-gap: 1.5rem;
  }
  @media (max-width: 600px) { .topic-cols { columns: 1; } }
  .topic-item {
    break-inside: avoid; padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-size: 0.85rem; color: var(--soft);
    display: flex; gap: 0.5rem; align-items: flex-start;
    line-height: 1.5;
  }
  .topic-item .tn {
    font-size: 0.7rem; color: var(--mist); min-width: 24px;
    font-weight: 700; margin-top: 0.1rem;
  }

  /* ── MVP ── */
  .mvp { background: var(--white); }
  .mvp-timeline {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem; margin-top: 2rem;
  }
  .mvp-block {
    border-radius: 12px; padding: 1.75rem;
    border: 2px solid transparent; transition: all 0.2s;
  }
  .mvp-block.m7 { background: rgba(46,107,80,0.07); border-color: var(--moss); }
  .mvp-block.m30 { background: rgba(200,169,110,0.07); border-color: var(--gold); }
  .mvp-block.m90 { background: rgba(107,79,58,0.07); border-color: var(--bark); }
  .mvp-block:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
  .mvp-label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em;
    margin-bottom: 0.5rem;
  }
  .mvp-block.m7 .mvp-label { color: var(--moss); }
  .mvp-block.m30 .mvp-label { color: #b8922a; }
  .mvp-block.m90 .mvp-label { color: var(--bark); }
  .mvp-block h3 { font-size: 1.1rem; color: var(--ink); margin-bottom: 1rem; }
  .mvp-block ul { list-style: none; }
  .mvp-block ul li {
    font-size: 0.85rem; color: var(--soft);
    padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);
